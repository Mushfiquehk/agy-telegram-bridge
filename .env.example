# ---- Required --------------------------------------------------------------
# From @BotFather on Telegram (/newbot). Keep it secret.
TELEGRAM_BOT_TOKEN=
# Your numeric Telegram user id(s), comma-separated. Only these people can talk
# to agy. Get yours by sending /whoami to your bot (or messaging @userinfobot).
ALLOWED_USER_IDS=

# ---- agy -------------------------------------------------------------------
# Command used to launch the Antigravity CLI. "agy" if it's on PATH, otherwise
# the full path, e.g. C:\Users\you\AppData\Local\Programs\agy\agy.exe
AGY_COMMAND=agy
# Folder agy works in by default (your project). %USERPROFILE% and ~ expand.
AGY_WORKDIR=%USERPROFILE%\code
# Folders /cwd may switch to (separate with ; on Windows). Defaults to AGY_WORKDIR.
ALLOWED_ROOTS=%USERPROFILE%\code
# Optional defaults (also changeable from Telegram with /model /effort /mode)
AGY_MODEL=
AGY_EFFORT=
# default | accept-edits | plan | auto
AGY_MODE=

# ---- Permissions -----------------------------------------------------------
# Headless agy can't ask you to approve a tool, so tools that need approval are
# skipped ("soft-denied"). Two ways to let it actually work:
#   1) recommended: add allow rules to %USERPROFILE%\.gemini\antigravity-cli\settings.json
#      (see examples\settings.json in this repo), and/or AGY_MODE=accept-edits
#   2) AGY_SKIP_PERMISSIONS=true -> --dangerously-skip-permissions (agy can run
#      ANY command on your PC). Only with ALLOWED_USER_IDS locked to you.
AGY_SKIP_PERMISSIONS=false
# Allow toggling the above from Telegram with /yolo on|off
ALLOW_YOLO_TOGGLE=false
# Run agy commands inside its terminal sandbox (if available on your machine)
AGY_SANDBOX=false
# Any extra flags appended to every agy launch, e.g. --add-dir D:\data
AGY_EXTRA_ARGS=

# ---- Bridge behaviour ------------------------------------------------------
# persistent = one warm agy process per chat (fast). oneshot = new process per
# message, resumed with --conversation (use if persistent misbehaves).
RUN_MODE=persistent
# Kill a turn that runs longer than this (seconds, 0 = never)
TURN_TIMEOUT_SECONDS=1800
# Close an idle agy process after this many seconds (conversation is kept)
IDLE_SHUTDOWN_SECONDS=1800
# Show tool calls (commands, file edits) live while agy works
SHOW_TOOL_CALLS=true
# How often the live status message is edited (Telegram rate-limits edits)
EDIT_INTERVAL_SECONDS=1.5
MAX_UPLOAD_MB=20
STATE_FILE=data\state.json

# ---- Developer tools -------------------------------------------------------
# Snapshot the git working tree before every agy turn so you get a
# "📝 3 files changed" line plus Diff / Undo buttons after each reply.
# (Uses `git stash create`, which touches nothing in your repo.)
CHECKPOINTS=true
# After agy is blocked from a tool, show buttons to retry with full access for
# one turn, or to add a permanent allow rule to agy's settings.json.
APPROVAL_BUTTONS=true
# Where agy keeps its settings (used by /allow and the "Always allow" button)
AGY_SETTINGS_PATH=%USERPROFILE%\.gemini\antigravity-cli\settings.json
# Let /sh <cmd> and "!cmd" run shell commands directly in the project folder
# (PowerShell on Windows). Anyone with your bot can then run commands on your PC,
# so keep ALLOWED_USER_IDS to yourself.
ALLOW_SHELL=false
# powershell (default on Windows) | pwsh | cmd ; on Linux/WSL defaults to $SHELL
SHELL_COMMAND=
SHELL_TIMEOUT_SECONDS=300
# Default command for /test. Leave empty to auto-detect per project (npm/pnpm/
# yarn test, pytest, cargo test, go test, dotnet test, mvn, gradle, make test).
# Per-project override from Telegram: /settest <cmd>
TEST_COMMAND=
TEST_TIMEOUT_SECONDS=900
# How deep /projects looks under ALLOWED_ROOTS for repos
PROJECT_SCAN_DEPTH=3
# Your own prompt shortcuts (see prompts.example.toml)
PROMPTS_FILE=prompts.toml
TRANSCRIPT_DIR=data\transcripts

# ---- Voice notes -----------------------------------------------------------
# auto: local faster-whisper if installed (pip install faster-whisper), else
# OpenAI if OPENAI_API_KEY is set. local | openai | off
VOICE_BACKEND=auto
OPENAI_API_KEY=
# faster-whisper size (tiny, base, small, medium, large-v3) or OpenAI model name
WHISPER_MODEL=
# e.g. en; empty = auto-detect
VOICE_LANGUAGE=
# Show the transcript with a Send button instead of sending it straight to agy
VOICE_CONFIRM=false
